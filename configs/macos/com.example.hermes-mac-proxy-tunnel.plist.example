<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.hermes-mac-proxy-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-i</string>
    <string>/Users/&lt;MAC_USER&gt;/.ssh/hermes-ubuntu</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>IdentitiesOnly=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ConnectTimeout=20</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>TCPKeepAlive=yes</string>
    <string>-o</string><string>StrictHostKeyChecking=yes</string>
    <string>-o</string><string>UserKnownHostsFile=/Users/&lt;MAC_USER&gt;/.ssh/known_hosts</string>
    <string>-p</string><string>&lt;VM_NAT_SSH_PORT&gt;</string>
    <string>-R</string><string>127.0.0.1:&lt;GUEST_PROXY_PORT&gt;:127.0.0.1:&lt;MAC_PROXY_PORT&gt;</string>
    <string>&lt;VM_USER&gt;@127.0.0.1</string>
  </array>
  <key>UserName</key><string>&lt;MAC_USER&gt;</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>/Users/&lt;MAC_USER&gt;</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/&lt;MAC_USER&gt;</string>
    <key>USER</key><string>&lt;MAC_USER&gt;</string>
    <key>LOGNAME</key><string>&lt;MAC_USER&gt;</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/&lt;MAC_USER&gt;/Library/Logs/hermes-mac-proxy-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/&lt;MAC_USER&gt;/Library/Logs/hermes-mac-proxy-tunnel.err.log</string>
</dict>
</plist>
